# arm64-specific overrides for release workflows.
# This file is loaded together with .env via COMPOSE_ENV_FILES in GitHub Actions.
#
# Example:
# VERSION=2.3.1-arm64
# DOCKER_IMAGE_BASE=icellmobilsoft/base:${VERSION}

# AUTO-DISABLED-BY-RENOVATE: JRE_17_TEMURIN_IMAGE=eclipse-temurin:17.0.21_9-jre
# AUTO-DISABLED-BY-RENOVATE: JDK_17_TEMURIN_IMAGE=eclipse-temurin:17.0.21_9-jdk
# AUTO-DISABLED-BY-RENOVATE: JRE_21_TEMURIN_IMAGE=eclipse-temurin:21.0.13_9-jre
# AUTO-DISABLED-BY-RENOVATE: JDK_21_TEMURIN_IMAGE=eclipse-temurin:21.0.13_9-jdk
# AUTO-DISABLED-BY-RENOVATE: JRE_25_TEMURIN_IMAGE=eclipse-temurin:25.0.5_8-jre
# AUTO-DISABLED-BY-RENOVATE: JDK_25_TEMURIN_IMAGE=eclipse-temurin:25.0.5_8-jdk

